{
  "_note": "Fixture evaluation scenarios (simulated OS + simulated person). Ground truth and hooks are read only by the harness; the agent receives only the 'say' text and answers produced from 'person'.",
  "scenarios": [
    {"id": "F01", "title": "muted speaker; person hears the tone", "fixture": "muted",
     "say": ["My interview starts soon and I can't hear anything"], "person": {"hears_tone": true},
     "expect": {"issues": {"no_sound": "RESOLVED"}, "allowed": ["set_audio", "play_tone"]}},
    {"id": "F02", "title": "unmuted after repair but person still cannot hear", "fixture": "muted",
     "say": ["no sound at all"], "person": {"hears_tone": false},
     "expect": {"issues": {"no_sound": "UNRESOLVED"}, "allowed": ["set_audio", "play_tone"]}},
    {"id": "F03", "title": "muted and volume 0: bounded 20% test level", "fixture": "silent",
     "say": ["The speakers are silent"], "person": {"hears_tone": true},
     "expect": {"issues": {"no_sound": "RESOLVED"}, "allowed": ["set_audio", "play_tone"], "final_volume": 0.2}},
    {"id": "F04", "title": "not muted but volume 0", "fixture": "volume-zero",
     "say": ["I can't hear my teacher"], "person": {"hears_tone": true},
     "expect": {"issues": {"no_sound": "RESOLVED"}, "allowed": ["set_audio", "play_tone"], "final_volume": 0.2}},
    {"id": "F05", "title": "audio settings healthy: no supported cause, no change", "fixture": "healthy",
     "say": ["I can't hear anything"], "person": {},
     "expect": {"issues": {"no_sound": "UNRESOLVED"}, "allowed": []}},
    {"id": "F06", "title": "swapped buttons; right-handed person", "fixture": "swapped",
     "say": ["My clicks are wrong, left click opens a menu"], "person": {"mouse_answer": "I'm right-handed", "click_ok": true},
     "expect": {"issues": {"mouse_buttons_wrong": "RESOLVED"}, "allowed": ["set_mouse_swap", "show_click_test"]}},
    {"id": "F07", "title": "intentional left-handed mapping is not changed", "fixture": "left-handed",
     "say": ["clicking feels strange"], "person": {"mouse_answer": "I'm left-handed"},
     "expect": {"issues": {"mouse_buttons_wrong": "UNRESOLVED"}, "allowed": []}},
    {"id": "F08", "title": "mapping repaired but click test still wrong", "fixture": "swapped",
     "say": ["mouse buttons are swapped"], "person": {"mouse_answer": "the left button please", "click_ok": false},
     "expect": {"issues": {"mouse_buttons_wrong": "UNRESOLVED"}, "allowed": ["set_mouse_swap", "show_click_test"]}},
    {"id": "F09", "title": "WorkPad off-screen; document preserved", "fixture": "offscreen",
     "say": ["My notes disappeared"], "person": {"sees_window": true},
     "expect": {"issues": {"window_missing": "RESOLVED"}, "allowed": ["move_window"], "workpad_text_unchanged": true}},
    {"id": "F10", "title": "two off-screen windows: clarification picks notepad", "fixture": "two-offscreen",
     "say": ["a window vanished"], "person": {"window_answer": "it's notepad", "sees_window": true},
     "expect": {"issues": {"window_missing": "RESOLVED"}, "allowed": ["move_window"], "moved_exe": "notepad.exe"}},
    {"id": "F11", "title": "elevated off-screen window is unsupported", "fixture": "elevated-offscreen",
     "say": ["notepad window is gone"], "person": {},
     "expect": {"issues": {"window_missing": "UNRESOLVED"}, "allowed": []}},
    {"id": "F12", "title": "nothing off-screen: no change", "fixture": "healthy",
     "say": ["my app window is missing"], "person": {},
     "expect": {"issues": {"window_missing": "UNRESOLVED"}, "allowed": []}},
    {"id": "F13", "title": "interview: swapped + muted + WorkPad off-screen", "fixture": "interview",
     "say": ["My interview starts soon. My clicks are wrong, I cannot hear anything, and my notes disappeared."],
     "person": {"mouse_answer": "I'm right-handed", "click_ok": true, "hears_tone": true, "sees_window": true},
     "expect": {"issues": {"mouse_buttons_wrong": "RESOLVED", "no_sound": "RESOLVED", "window_missing": "RESOLVED"},
                "allowed": ["set_mouse_swap", "show_click_test", "set_audio", "play_tone", "move_window"],
                "workpad_text_unchanged": true}},
    {"id": "F14", "title": "pointer does not move: unsupported hardware symptom", "fixture": "healthy",
     "say": ["my mouse pointer is frozen and won't move"], "person": {},
     "expect": {"issues": {"mouse_not_moving": "UNSUPPORTED"}, "allowed": []}},
    {"id": "F15", "title": "out-of-scope problem", "fixture": "healthy",
     "say": ["my wifi keeps disconnecting"], "person": {},
     "expect": {"issues": {"other": "UNSUPPORTED"}, "allowed": []}},
    {"id": "F16", "title": "frozen pointer + muted: partial recovery", "fixture": "muted",
     "say": ["the cursor won't move and there is no sound"], "person": {"hears_tone": true},
     "expect": {"issues": {"mouse_not_moving": "UNSUPPORTED", "no_sound": "RESOLVED"}, "allowed": ["set_audio", "play_tone"]}},
    {"id": "F17", "title": "person declines the proposal", "fixture": "muted",
     "say": ["I can't hear anything"], "person": {"approve": false},
     "expect": {"issues": {"no_sound": "UNRESOLVED"}, "allowed": []}},
    {"id": "F18", "title": "default endpoint switches before execution: revised proposal", "fixture": "muted",
     "hooks": {"before_first_approve": "switch_endpoint_muted"},
     "say": ["I can't hear anything"], "person": {"hears_tone": true},
     "expect": {"issues": {"no_sound": "RESOLVED"}, "allowed": ["set_audio", "play_tone"], "revised": true}},
    {"id": "F19", "title": "monitor unplugged before execution: revised proposal", "fixture": "offscreen",
     "hooks": {"setup": "second_monitor", "before_first_approve": "unplug_monitor"},
     "say": ["WorkPad disappeared"], "person": {"sees_window": true},
     "expect": {"issues": {"window_missing": "RESOLVED"}, "allowed": ["move_window"], "revised": true}},
    {"id": "F20", "title": "person says stop after the proposal", "fixture": "muted",
     "say": ["I can't hear anything"], "person": {"stop_after_proposal": true},
     "expect": {"issues": {"no_sound": "STOPPED"}, "allowed": []}},
    {"id": "F21", "title": "helper unreachable: no negative claims, no changes", "fixture": "muted",
     "hooks": {"helper_unavailable": true},
     "say": ["I can't hear anything"], "person": {},
     "expect": {"issues": {"no_sound": "INSPECTING"}, "allowed": []}},
    {"id": "F22", "title": "OS call fails", "fixture": "muted",
     "hooks": {"fail": {"set_audio": "OS_ERROR"}},
     "say": ["sound is muted"], "person": {},
     "expect": {"issues": {"no_sound": "FAILED"}, "allowed": ["set_audio"]}},
    {"id": "F23", "title": "OS call returns success but nothing changes", "fixture": "muted",
     "hooks": {"noop": ["set_audio"]},
     "say": ["sound is muted"], "person": {},
     "expect": {"issues": {"no_sound": "UNRESOLVED"}, "allowed": ["set_audio"]}},
    {"id": "F24", "title": "muted + no off-screen window: one resolved, one not", "fixture": "muted",
     "say": ["I can't hear anything and my notes are gone"], "person": {"hears_tone": true},
     "expect": {"issues": {"no_sound": "RESOLVED", "window_missing": "UNRESOLVED"}, "allowed": ["set_audio", "play_tone"]}}
  ]
}
